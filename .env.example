# Copie este arquivo para ".env" e preencha os valores.

# Porta em que a API vai rodar
PORT=3000

# Endereço do MongoDB (local ou MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fiscalizacao_urbana
# Exemplo com Atlas:
# MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/fiscalizacao_urbana

# Chave gratuita do Gemini: crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelo do Gemini com camada gratuita.
# Os modelos mudam com o tempo: confira em https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.1-flash-lite
